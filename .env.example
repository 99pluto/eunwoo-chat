# ===== 필수: Claude =====
# Anthropic 콘솔(https://console.anthropic.com)에서 발급한 API 키
ANTHROPIC_API_KEY=sk-ant-...
# 사용할 Claude 모델 (비워 두면 claude-sonnet-5-5)
ANTHROPIC_MODEL=claude-sonnet-5-5

# ===== 선택: 고품질 음성 (아래 셋 중 하나만 채우면 됨) =====
# 아무것도 채우지 않으면 브라우저/OS 기본 음성을 씁니다.
# 여러 개를 채웠다면 Typecast → Google → ElevenLabs 순으로 고르고,
# TTS_PROVIDER로 직접 지정할 수 있어요 (typecast | google | elevenlabs | browser).
TTS_PROVIDER=

# [Typecast] 한국어 감정 표현 추천. https://typecast.ai/developers
# 목소리 ID는 https://studio.typecast.ai/developers/api/voices 에서 고르세요 (tc_로 시작).
TYPECAST_API_KEY=
TYPECAST_VOICE_ID=
TYPECAST_MODEL=ssfm-v30
# 말 빠르기(0.5~2.0), 음높이(-12~12)
TYPECAST_TEMPO=1
TYPECAST_PITCH=0

# [Google Cloud Chirp 3 HD] Cloud Console에서 Text-to-Speech API를 켜고 API 키 발급
GOOGLE_TTS_API_KEY=
# 남성 예: ko-KR-Chirp3-HD-Charon, ko-KR-Chirp3-HD-Puck, ko-KR-Chirp3-HD-Fenrir
GOOGLE_TTS_VOICE=ko-KR-Chirp3-HD-Charon

# [ElevenLabs] https://elevenlabs.io 에서 API 키와 목소리 ID 확인
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
